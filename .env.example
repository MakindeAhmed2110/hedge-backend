# Server
PORT=8787
NODE_ENV=development

# Postgres — pick one:
# Local Docker:  docker compose up -d
# DATABASE_URL=postgresql://hedge:hedge@localhost:5432/hedge

# Supabase: Project Settings → Database → Connection string → URI (Session pooler)
# Replace [YOUR-PASSWORD]. Use the pooler host (port 5432), not the direct DB host.
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# DATABASE_SSL=require

# Marketing site + referral links: https://hedgeapp.trade/?ref=username
HEDGE_APP_URL=https://hedgeapp.trade

# Deployed API (DNS: api.hedgeapp.trade → your host)
# Local dev: http://localhost:8787
HEDGE_API_URL=https://api.hedgeapp.trade

# Server-to-server secret — generate once (see README). NEVER commit real value.
# Used by my-app app/api/* and cron indexer. NOT in EXPO_PUBLIC_*.
HEDGE_SERVICE_KEY=

# Optional: verify Privy JWTs directly (same app id as my-app)
PRIVY_APP_ID=

# DeepBook predict-server (testnet)
PREDICT_SERVER_URL=https://predict-server.testnet.mystenlabs.com

# Points: $10 mint volume = 1 point (use USD_PER_POINT or POINTS_PER_USD=0.1)
USD_PER_POINT=10
POINTS_PER_USD=0.1
REFERRAL_SIGNUP_POINTS=10
REFERRAL_VOLUME_SHARE_BPS=500

# DUSDC has 6 decimals on testnet
QUOTE_DECIMALS=6

# Waitlist (pre-launch; public routes — no Privy required)
WAITLIST_ENABLED=true
WAITLIST_BASE_POINTS=100
WAITLIST_REFERRAL_GIVEN_POINTS=10
WAITLIST_REFERRAL_USED_POINTS=10
WAITLIST_SHARED_ON_X_POINTS=25
WAITLIST_DOWNLOADED_APP_POINTS=25
WAITLIST_REFERRAL_BONUS_PERCENT=10

# In-memory cache TTL (ms) — hot paths
CACHE_VALIDATE_TTL_MS=60000
CACHE_LEADERBOARD_TTL_MS=15000
DATABASE_POOL_MAX=8
